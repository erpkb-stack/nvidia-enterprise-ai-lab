# Copy to backend/.env for local development (the backend reads .env from its working directory).
# Docker Compose reads this file from the repository root.

POSTGRES_DB=nvidia_lab
POSTGRES_USER=nvidia_lab
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://nvidia_lab:change_me_local_only@localhost:5432/nvidia_lab
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=local
LOG_LEVEL=INFO
# true = create tables on startup (quick start). Use false + `alembic upgrade head` for real databases.
AUTO_CREATE_TABLES=true

# --- NVIDIA inference (optional). Without these every module runs on labelled offline fallbacks.
# Hosted NVIDIA API catalog: create a key at https://build.nvidia.com and set NVIDIA_NIM_API_KEY.
# Self-hosted NIM: set NVIDIA_NIM_BASE_URL=http://<nim-host>:8000/v1 (key optional).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
# Catalog models get retired over time; list what your key can use with GET {base_url}/models.
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# Optional reranking NIM endpoint (empty = local reranker). Needs both the URL and the model name.
NVIDIA_RERANK_URL=
NVIDIA_RERANK_MODEL=

# --- Limits
RAG_MAX_UPLOAD_MB=15
BENCH_MAX_REQUESTS=64
BENCH_MAX_CONCURRENCY=16
